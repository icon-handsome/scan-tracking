  "statistical_stddev_mul": 3.0,
  "voxel_leaf_mm": 2.0,

  // 封头直边圆柱拟合参数
  "cylinder_distance_threshold_mm": 2.0,
  "cylinder_max_iterations": 200,

  // 全局 ICP 匹配参数：模板整体匹配使用
  "icp_max_correspondence_distance_mm": 50.0,
  "icp_max_iterations": 300,
  "icp_transformation_epsilon": 1e-8,
  "icp_fitness_epsilon": 0.001,

  // 圆度切片参数：每个有效切片单独计算圆度，最终圆度取中值
  "slice_spacing_mm": 5.0,
  "slice_count": 5,
  "slice_min_points": 30,
  "slice_thickness_mm": 2.0,
  "circle_max_fit_error_mm": 3.0,

