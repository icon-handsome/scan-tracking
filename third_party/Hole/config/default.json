  "straight_endpoint_slice_thickness_mm": 2.0,
  "straight_line_distance_threshold_mm": 4.0,
  "straight_a_to_b_max_distance_mm": 60.0,
  "straight_b_method": "nearest",
  "straight_b_line_fit_length_mm": 35.0,
  "straight_b_residual_min_threshold_mm": 0.2,
  "straight_b_residual_window_count": 3,

