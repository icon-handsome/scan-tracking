# Cursor / VS Code：配合 compile_commands.json 提供代码跳转、引用查找与补全。
# 构建目录与 CMakePresets.json 中 win-msvc2019-qtcore-ninja-debug 保持一致。

CompileFlags:
  CompilationDatabase: build/win-msvc2019-qtcore-ninja-debug
  Add:
    - --driver-mode=cl
  Remove:
    - /external:W0

Index:
  StandardLibrary: Yes

---

# 不索引生成物与 IDE 本地库（减轻卡顿）
If:
  PathMatch: .*/(build|\.vs|\.cache)(/|$).*

Index:
  Background: Skip

---

# 跳过体积巨大的第三方预编译树（头文件仍可通过 compile_commands 解析）
If:
  PathMatch: .*/third_party/opencv[^/]*/.*

Index:
  Background: Skip

---

If:
  PathMatch: .*/third_party/MVS/(Applications|MVS)/.*

Index:
  Background: Skip

---

If:
  PathMatch: .*/third_party/.*/(bin|lib|runtime|logs|data|config)(/|$).*

Index:
  Background: Skip

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - "*-unused-includes"

---

# 双工位解耦：禁止索引第二工位源码
If:
  PathMatch: .*/IPC_Station2(/|$).*

Index:
  Background: Skip
