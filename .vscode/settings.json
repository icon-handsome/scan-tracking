    "C_Cpp.default.compilerPath": "C:/Program Files/Microsoft Visual Studio/18/Community/VC/Tools/MSVC/14.29.30133/bin/Hostx64/x64/cl.exe",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.enhancedColorization": "Disabled",
    "C_Cpp.formatting": "Disabled",
    "C_Cpp.autoAddFileAssociations": false,

    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.definitionLinkOpensInPeek": false,

    "files.exclude": {
        "**/.cache": true,
        "**/.cache/**": true,
        "**/.vs": true,
        "**/.vs/**": true,
        "**/build/**": true,
        "**/third_party/MVS/Development/Samples/**": true,
        "**/third_party/MVS/Development/MVFG/**": true,
